{
  "name": "personal-ai-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "tsx scripts/verify-ui.ts",
    "test:a11y": "tsx scripts/verify-accessibility.ts",
    "test:ui:live": "tsx scripts/verify-live-ui.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "verify:connections": "tsx --env-file=.env.local scripts/verify-connections.ts",
    "verify:n8n": "tsx --env-file=.env.local scripts/verify-n8n.ts",
    "test:boundary": "tsx scripts/verify-boundary.ts",
    "format:check": "prettier --check src scripts tests docs README.md db/README.md"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "jose": "^6.1.3",
    "next": "16.4.6",
    "pg": "^8.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "eslint": {
      "minimatch": "11.0.5"
    }
  }
}
