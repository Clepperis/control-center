# Copy to .env.local. Placeholders only; never commit real values.
AUTH_MODE=development
DATA_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
# Phase 6 production: AUTH_MODE=password, HTTPS APP_ORIGIN, stable OWNER_SUBJECT
# and a random >=32-character AUTH_SECRET from protected operator configuration.
# Bootstrap/reset only via the interactive owner:password command. No signup.
AUTH_SECRET=
# Separate operator/migration credentials; never deliver to web/worker/executor.
OPERATOR_DATABASE_URL=
MIGRATION_DATABASE_URL=
# Legacy explicitly selected OIDC configuration; no password fallback to OIDC.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OWNER_SUBJECT=
# Local operational state: use your own PostgreSQL database for live mode.
DATABASE_URL=
# Absolute private data directory OUTSIDE this public checkout. Same local
# persistent filesystem for web and worker; no network/Obsidian Sync required.
# Linux example: /var/lib/control-center/knowledge (owner-only permissions).
KNOWLEDGE_ROOT=
# Separate application credentials. Codex connections are not reused.
NEXOS_API_KEY=
NEXOS_MODEL=
# Optional per-tier models (exact catalog IDs). Empty = use NEXOS_MODEL.
# chat -> FAST, knowledge -> STANDARD, Platform Engineer -> STRONG.
NEXOS_MODEL_FAST=
NEXOS_MODEL_STANDARD=
NEXOS_MODEL_STRONG=
NEXOS_MAX_COMPLETION_TOKENS=1200
NEXOS_TIMEOUT_MS=30000
PAPERCLIP_BASE_URL=
PAPERCLIP_BOARD_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_AGENT_IDS=
# Shared telemetry only; does not enable task execution or change budgets.
# Absolute private JSON file; default is .local/usage/snapshot.json in this checkout.
USAGE_SNAPSHOT_FILE=
USAGE_WINDOW_DAYS=30
USAGE_SYNC_INTERVAL_MS=300000
# Agents whose AGENTS.md receive the marked usage report with --publish.
USAGE_PAPERCLIP_AGENT_IDS=
# Optional local JSONL roots separated by the OS path delimiter (; on Windows).
# Defaults: ~/.codex/sessions + archived_sessions, ~/.claude/projects.
USAGE_CODEX_ROOTS=
USAGE_CLAUDE_ROOTS=
# Optional absolute path; defaults to ~/.claude/usage/claude-quota.json.
USAGE_CLAUDE_QUOTA_FILE=
# Deliberate switches; keep off until a concrete live test is approved.
LIVE_MODEL_ENABLED=false
LIVE_DELEGATION_ENABLED=false
# Installed application REST contract must be checked with operator credentials.
PAPERCLIP_CONTRACT_VERIFIED=false
RECONCILE_INTERVAL_MS=30000
# Separate application MCP token from n8n Settings > Instance-level MCP.
# This is not a REST API key or a Codex OAuth token. HTTPS origin only.
N8N_ORIGIN=
N8N_MCP_TOKEN=
N8N_TIMEOUT_MS=8000
# Pin the independently reviewed, dedicated unpublished two-node example.
N8N_TEXT_WORKFLOW_ID=
N8N_TEXT_WORKFLOW_VERSION=
# Keep false until the owner approves the exact live test/action.
N8N_EXECUTION_ENABLED=false
# Phase 5: a separate application coding boundary. No deploy credentials.
IMPROVEMENT_EXECUTOR_ENABLED=false
IMPROVEMENT_REPOSITORY=Clepperis/control-center
# Continue from the completed implementation, never assume main is current.
IMPROVEMENT_TARGET_BRANCH=codex/phase-5-platform-engineer
# Optional Contents/Actions read token for this repository only. Public reads
# work without it but are rate limited. Runtime write access is separate.
IMPROVEMENT_GITHUB_READ_TOKEN=
# Absolute operator-owned JSON OUTSIDE all agent workspaces and this checkout.
# See docs/PHASE-5.md. An example is not proof of sandbox/budget enforcement.
IMPROVEMENT_POLICY_FILE=
