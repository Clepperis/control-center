AUTH_MODE=password
DATA_MODE=live
APP_ORIGIN=https://HOSTNAME_PENDING.duckdns.org
OWNER_SUBJECT=owner-PERSISTENT_RANDOM_ID
AUTH_SECRET=GENERATE_IN_APPROVED_SECRET_STORE
DATABASE_URL=SET_USING_PROTECTED_RUNTIME_ROLE_CONFIG
KNOWLEDGE_ROOT=/var/lib/control-center/knowledge
LIVE_MODEL_ENABLED=false
LIVE_DELEGATION_ENABLED=false
N8N_EXECUTION_ENABLED=false
IMPROVEMENT_EXECUTOR_ENABLED=false
PAPERCLIP_CONTRACT_VERIFIED=false
# Integration credentials are absent initially. Add separately authorized keys
# only to the processes that use them; never add deployment/backup credentials.
